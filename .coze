[project]
sub_id = "ad8babbd"
name = "doo-multi-agent"
requires = ["nodejs-24"]
project_type = "web"
version = "0.0.35"
project_id = "7688949282086567976"
app_id = "7688985040650534947"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "doo-multi-agent/scripts/build.sh"]
run = ["bash", "doo-multi-agent/scripts/run.sh"]

[deploy]
build = ["bash", "doo-multi-agent/scripts/build.sh"]
run = ["bash", "doo-multi-agent/scripts/run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true

[subprojects]
path = ["doo-multi-agent"]
