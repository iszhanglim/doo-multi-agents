# ===========================================================================
# DOO 多智能体系统 —— 本地开发环境变量样例
#
# 用法：cp .env.example .env 后按需修改。
#   本文件只覆盖本地开发；生产环境变量请在「扣子编程 → 部署 → 生产环境变量」中逐个新建，
#   完整清单与取值说明见 AGENTS.md §6 与 docs/COZE.md §4。
#
# 载入方式：web/server/index.ts 顶部用 dotenv 读取
#   config({ path: resolve(__dirname, '../../.env') })
#   —— 脚本侧不要再 source 本文件（见 scripts/run.sh 的说明）。
# ===========================================================================

# ========== LLM 配置 ==========
# provider 取值：coze | openai | anthropic | custom
#   coze     ：平台托管模型，凭据自动注入，无需 key（本地若未接平台则不可用）
#   openai   ：OpenAI 兼容协议（DeepSeek 走这条）
#   custom   ：把 LLM_BASE_URL 当作完整 endpoint 直接 POST，允许免鉴权端点
#   anthropic：Anthropic Messages API
LLM_PROVIDER=openai

# API 密钥。仅 openai / anthropic 必填；custom 可选（免鉴权自建服务可留空）。
# 生产环境请只写在平台环境变量里，禁止硬编码或提交入库。
LLM_API_KEY=sk-your-api-key-here

# 完整 endpoint（openai / custom 都把它当完整 URL 直接 fetch）。
# 注意：必须带 /chat/completions 后缀，写成 baseURL 形式会 404。
LLM_BASE_URL=https://api.deepseek.com/chat/completions

# 模型名。默认 doubao-seed-2-0-pro-260215（coze 托管）；
# DeepSeek 示例：deepseek-chat / deepseek-flash
LLM_MODEL=deepseek-flash

# 生成温度 (0.0-1.0)。注意 0 是合法值（可用 LLM_TEMPERATURE=0 求确定性输出）。
LLM_TEMPERATURE=0.7

# 最大 token 数。思考型模型需要显著调大，否则思考过程会耗尽预算、content 返回空。
LLM_MAX_TOKENS=8192

# 透传到请求体的额外字段（JSON 对象）。
# DeepSeek 思考模型必须关闭思考模式，否则 content 可能为空：
#   LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# 说明：保留键 model / messages 会被忽略（防止静默改写请求语义）。
# 该字段当前仅对 openai / custom / anthropic 生效，coze 路径不受其控制。
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 单次 LLM 调用超时（毫秒）。平台对「无数据交互」约 90s 断连，
# 配合重试 2 次，建议不超过 30s（默认 30000）。
LLM_TIMEOUT_MS=30000

# ========== 存储配置 ==========
# 存储类型：json（本地文件，仅单机演示可用）
# 生产请配置 DATABASE_URL 以启用 PostgreSQL；容器重启会清空本地目录，JSON 模式会丢数据。
STORAGE_TYPE=json

# JSON 模式下的数据目录（相对 web/ 工作目录解析）
DATA_PATH=./data

# 生产必填：PostgreSQL 连接串（「扣子 → 数据库 → 设置」复制）
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# ========== Web 服务器配置 ==========
# 端口。平台会注入 PORT，代码已读取；本地默认 3001（见 web/server/index.ts）。
# 注意不要把生产端口写死。
# PORT=3001

# ========== 访问控制（⚠️ 公网部署必读）==========
# 站点级共享口令。设置后，除 /api/health 外所有请求需 HTTP Basic 认证
# （用户名任意，密码填该值）。扣子只支持公开部署，不设口令等于接口全公开。
ACCESS_CODE=change-me-before-deploying

# Basic 认证提示语（可选）
# ACCESS_REALM=DOO Multi-Agent

# 每 IP 每分钟 /api/* 请求上限，默认 120；设 0 关闭。
# 注意：IP 来自 X-Forwarded-For，可被伪造，因此另有全站上限兜底。
RATE_LIMIT_PER_MIN=120

# 全站每分钟请求上限（默认 RATE_LIMIT_PER_MIN×10），用于兜住伪造 IP 绕过按 IP 限流的情况
# RATE_LIMIT_GLOBAL_PER_MIN=1200

# 登录令牌签名密钥。默认复用 ACCESS_CODE；生产更推荐单独设置一个随机值。
# AUTH_SECRET=please-set-a-random-secret

# 登录令牌有效期（小时），默认 12
# AUTH_TOKEN_TTL_HOURS=12

# TTS 缓存有效期（小时），默认 24。沙箱磁盘有限，缓存需要能回收。
# TTS_CACHE_TTL_HOURS=24
